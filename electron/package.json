{
  "name": "@epic-ai/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Epic AI — Electron-клиент: компактный overlay поверх игры, окно источников, настройки, админ-панель",
  "main": "main/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.epicrp.epic-ai",
    "productName": "Epic AI",
    "directories": { "output": "release" },
    "files": [
      "main/**/*",
      "preload/**/*",
      "../renderer/**/*",
      "../shared/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "EpicAI-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Epic AI"
    }
  }
}
