{
  "name": "@epic-ai/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Epic AI backend: auth, RBAC, knowledge base, crawler, RAG, AI reports",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:status": "tsx src/db/cli.ts status",
    "crawl": "tsx src/crawler/cli.ts",
    "sync": "tsx src/knowledge/sync-cli.ts",
    "bootstrap:developer": "tsx src/bootstrap/developer.ts",
    "kb:reindex": "tsx src/knowledge/reindex-cli.ts",
    "test": "tsx --test test/*.test.ts",
    "users": "tsx src/bootstrap/admin-cli.ts",
    "doctor": "tsx src/bootstrap/admin-cli.ts --doctor"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "undici": "^7.30.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
